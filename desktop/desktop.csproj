<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Copyright>© 2026 Dovitc-off</Copyright>
    <VersionFile>$(MSBuildProjectDirectory)\..\build.yml</VersionFile>
    <YamlContent Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)'))</YamlContent>
    <GameVersion Condition="'$(YamlContent)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(YamlContent), '(?s).*?version:\s*["'']?([^"''\r\n]+).*', '$1'))</GameVersion>
    <Version Condition="'$(GameVersion)' != ''">$(GameVersion)</Version>
    <InformationalVersion Condition="'$(GameVersion)' != ''">$(GameVersion)</InformationalVersion>
    <AssemblyVersion Condition="'$(GameVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(GameVersion), '^(\d+\.\d+\.\d+)(?:-.*)?$', '$1.0'))</AssemblyVersion>
    <FileVersion Condition="'$(GameVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(GameVersion), '^(\d+\.\d+\.\d+)(?:-.*)?$', '$1.0'))</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\core\Content\Content.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\core\Content\json\**\*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Content\json\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
  <Target Name="GenerateMGCB"
    BeforeTargets="Build"
    Condition="'$(SkipContentGeneration)' != 'true'">
      <Exec Command="dotnet-script &quot;$(MSBuildProjectDirectory)/../core/tools/GenerateMGCB.csx&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>
</Project>