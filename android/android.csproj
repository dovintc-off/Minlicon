<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>Minlicon.Android.Minlicon.Android</ApplicationId>
    <ApplicationVersion>0.2</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0-alpha</ApplicationDisplayVersion>
    <AndroidEnableFastDeployment Condition="'$(Configuration)' == 'Debug'">false</AndroidEnableFastDeployment>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\core.csproj" />
    <MonoGameContentReference Include="..\core\Content\Content.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="..\core\Content\assets\json\**\*.json"
                  Link="assets/data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="GenerateMGCB" BeforeTargets="RunContentBuilder">
    <Exec Command="dotnet-script &quot;$(MSBuildProjectDirectory)/../core/tools/GenerateMGCB.csx&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>
  <ItemGroup>
      <Compile Remove="tools/**/*.cs" />
  </ItemGroup>
</Project>