<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0-android</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" Condition="'$(TargetFramework)' == 'net10.0-android'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\assets\fonts\MedeoSans-Black.ttf">
      <LogicalName>Minlicon.assets.fonts.MedeoSans-Black.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>